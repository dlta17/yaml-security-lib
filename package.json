{
  "name": "yaml-security-lib",
  "version": "1.17.0",
  "description": "Secure YAML parser — duplicate key detection, alias depth limiting, prototype pollution prevention",
  "main": "index.cjs",
  "types": "src/index.d.ts",
  "type": "module",
  "bin": {
    "yaml-lint": "bin/yaml-lint.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.min.js",
      "require": "./index.cjs"
    },
    "./core": {
      "types": "./src/core.d.ts",
      "import": "./src/core.min.js",
      "require": "./src/core.cjs"
    },
    "./validate": {
      "types": "./src/validate.d.ts",
      "import": "./src/validate.min.js",
      "require": "./src/validate.cjs"
    },
    "./lint": {
      "types": "./src/lint.d.ts",
      "import": "./src/lint.min.js",
      "require": "./src/lint.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.min.js",
    "src/index.cjs",
    "src/core.min.js",
    "src/core.cjs",
    "src/validate.min.js",
    "src/validate.cjs",
    "src/lint.min.js",
    "src/lint.cjs",
    "src/index.d.ts",
    "src/core.d.ts",
    "src/validate.d.ts",
    "src/lint.d.ts",
    "index.cjs",
    "bin/yaml-lint.js",
    "dist/",
    "LICENSE",
    "LICENSE.COMMERCIAL"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node test/index.js && node test/fuzz.js && node test/stream.js && node test/stream-fuzz.js && node test/yaml-test-suite.js && node test/tree-suite.js && node test/validate.js && node test/lint.js && node test/entries.js",
    "lint": "node bin/yaml-lint.js examples/basic.yaml",
    "prepack": "npm run build:cjs && npm run build:esm && npm run build:browser",
    "example": "node examples/basic.js",
    "bench": "node bench/benchmark.js",
    "build": "npm run build:cjs && npm run build:esm && npm run build:browser",
    "build:cjs": "rollup -c --environment FORMAT:cjs",
    "build:esm": "rollup -c --environment FORMAT:esm",
    "build:types": "tsc --noEmit -p tsconfig.json --allowJs false",
    "build:browser": "mkdir -p dist && rollup -c --environment FORMAT:browser-iife && rollup -c --environment FORMAT:browser-esm"
  },
  "keywords": [
    "yaml",
    "security",
    "duplicate-keys",
    "alias-depth",
    "prototype-pollution",
    "yaml-parse",
    "safe-yaml",
    "linter",
    "yaml-lint"
  ],
  "license": "AGPL-3.0-only",
  "author": "Nedal Ibrahim <salamanedal@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlta17/yaml-security-lib.git"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "js-yaml": "^5.2.3",
    "rollup": "^4.62.3",
    "typescript": "^5.6.2",
    "yaml": "^2.9.0"
  }
}
